# Copy to .env.development / .env.local and adjust.
# Never hardcode API URLs in code — configure them here only.

# Where the Vite dev-server proxies /api requests in development.
VITE_PROXY_TARGET=http://localhost:8000

# Base path of the FakeDetect REST API. In production nginx serves the SPA and
# proxies /api/* to FastAPI on the same origin, so "/api/v1" is the default.
VITE_API_URL=/api/v1

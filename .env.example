PROVIDER=gemini
GEMINI_API_KEY=
GROK_API_KEY=

# Telegram уведомления (опционально)
# получить токен у @BotFather
TELEGRAM_BOT_TOKEN=
# узнать chat_id у @userinfobot
TELEGRAM_CHAT_ID=

# Безопасность (рекомендуется для продакшена)
# Разрешённые CORS-источники через запятую; пусто = только same-origin
ALLOWED_ORIGINS=
# Если задан — защищённые эндпоинты (/history, /stats, /whitelist) требуют заголовок X-API-Key
API_SECRET_KEY=

# --- Block A: надёжность продакшена -----------------------------------------
# Структурированные JSON-логи: text | json
LOG_FORMAT=text
# Общий таймаут всего пути запроса (приём -> LLM -> БД), секунд
REQUEST_TIMEOUT_BUDGET_SECONDS=55
# Circuit breaker на каждого провайдера: N ошибок подряд -> размыкание
CB_FAILURE_THRESHOLD=5
CB_RECOVERY_BASE_SECONDS=10
CB_RECOVERY_MAX_SECONDS=600
# Token bucket: превентивный троттлинг исходящих вызовов к LLM API
RL_CAPACITY=30
RL_REFILL_RATE=0.5
# Retry-очередь: интервал опроса воркером (сек) и максимум попыток
RETRY_QUEUE_POLL_SECONDS=15
RETRY_QUEUE_MAX_ATTEMPTS=5
# TTL кэша идемпотентности (часы)
IDEMPOTENCY_TTL_HOURS=24

# --- Block B: форензика и многоуровневый движок ------------------------------
# pHash: порог хэммингова расстояния «то же изображение» (из 64 бит)
PHASH_HAMMING_THRESHOLD=8
# ELA: качество пересжатия и порог флага редактирования
ELA_QUALITY=90
ELA_FLAG_THRESHOLD=25
# Консенсус: диапазон пограничной уверенности, запускающий второго провайдера
CONSENSUS_CONFIDENCE_LOW=40
CONSENSUS_CONFIDENCE_HIGH=70
# Веса композитного счёта final_score = Σ(w·s)/Σw
W_LLM_CONFIDENCE=0.45
W_PHASH_SIMILARITY=0.25
W_ELA=0.15
W_EXIF=0.05
W_PRICE=0.10
PRICE_FLOOR=0.2
PRICE_CEILING=0.8

# --- Block F: мульти-тенантность и биллинг -----------------------------------
# HMAC-секрет вебхуков биллинга (fail-closed: без секрета вебхуки отклоняются)
BILLING_STRIPE_WEBHOOK_SECRET=
BILLING_YOOKASSA_WEBHOOK_SECRET=
# Партнёрский API: лимит запросов на ключ в минуту
PARTNER_RATE_LIMIT_PER_MIN=30

# --- Block D: evidence & workflow --------------------------------------------
# Каталог файлов-доказательств (по подпапке на check id)
EVIDENCE_DIR=evidence
# Best-effort полные скриншоты карточек при открытии кейса
EVIDENCE_SCREENSHOTS_ENABLED=true

# --- Block C: автономный мониторинг (Discovery) ------------------------------
# Интервал опроса планировщиком (сек) и максимум запускаемых watch'ей за тик
DISCOVERY_TICK_SECONDS=60
SCHEDULER_DUE_BATCH=5
# Лимиты скана: карточек на ключевое слово и параллельных анализов
DISCOVERY_MAX_LISTINGS_PER_KEYWORD=20
DISCOVERY_CONCURRENCY=3
# TTL повторной проверки найденной карточки по вердикту (дней)
RECHECK_ORIGINAL_DAYS=7
RECHECK_SUSPICIOUS_DAYS=2
RECHECK_FAKE_DAYS=1
# Дайджест по умолчанию (часы), переопределяется per-watch
DIGEST_DEFAULT_HOURS=24

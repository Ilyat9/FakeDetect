PROVIDER=gemini
GEMINI_API_KEY=
GROK_API_KEY=

# Telegram уведомления (опционально)
# получить токен у @BotFather
TELEGRAM_BOT_TOKEN=
# узнать chat_id у @userinfobot
TELEGRAM_CHAT_ID=

# Безопасность (рекомендуется для продакшена)
# Разрешённые CORS-источники через запятую; пусто = только same-origin
ALLOWED_ORIGINS=
# Если задан — защищённые эндпоинты (/history, /stats, /whitelist) требуют заголовок X-API-Key
API_SECRET_KEY=
